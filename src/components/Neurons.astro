---

---

<div class="neurons-bg" aria-hidden="true">
  <canvas id="neurons-canvas"></canvas>
</div>

<style>
  .neurons-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .neurons-bg canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script type="module">
  const canvas = document.getElementById("neurons-canvas");
  if (!canvas) throw new Error("Canvas not found");
  const ctx = canvas.getContext("2d");

  let dpr = Math.max(window.devicePixelRatio || 1, 1);
  function resize() {
    dpr = Math.max(window.devicePixelRatio || 1, 1);
    canvas.width = Math.floor(canvas.clientWidth * dpr);
    canvas.height = Math.floor(canvas.clientHeight * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  window.addEventListener("resize", resize, { passive: true });

  const cfg = {
    count: 40,
    maxLinkDistance: 180,
    speed: 0.3,
    nodeRadius: 2.2,
    lineWidth: 0.9,
    nodeColor: "rgba(150,180,255,0.9)",
  };
  let pointer = { x: -9999, y: -9999 };
  canvas.addEventListener("pointermove", (e) => {
    const r = canvas.getBoundingClientRect();
    pointer.x = e.clientX - r.left;
    pointer.y = e.clientY - r.top;
  });
  canvas.addEventListener("pointerleave", () => {
    pointer.x = -9999;
    pointer.y = -9999;
  });

  function rand(min, max) {
    return Math.random() * (max - min) + min;
  }
  const nodes = [];
  function initNodes(w, h) {
    nodes.length = 0;
    for (let i = 0; i < cfg.count; i++) {
      nodes.push({
        x: rand(0, w),
        y: rand(0, h),
        vx: rand(-cfg.speed, cfg.speed),
        vy: rand(-cfg.speed, cfg.speed),
        r: cfg.nodeRadius,
      });
    }
  }
  initNodes(canvas.clientWidth, canvas.clientHeight);

  function step() {
    const w = canvas.clientWidth,
      h = canvas.clientHeight;
    ctx.clearRect(0, 0, w, h);
    for (const n of nodes) {
      n.x += n.vx;
      n.y += n.vy;
      if (n.x < -10) n.x = w + 10;
      if (n.x > w + 10) n.x = -10;
      if (n.y < -10) n.y = h + 10;
      if (n.y > h + 10) n.y = -10;
    }
    ctx.lineWidth = cfg.lineWidth;
    for (let i = 0; i < nodes.length; i++) {
      const a = nodes[i];
      for (let j = i + 1; j < nodes.length; j++) {
        const b = nodes[j];
        const dx = a.x - b.x,
          dy = a.y - b.y,
          dist2 = dx * dx + dy * dy,
          md2 = cfg.maxLinkDistance * cfg.maxLinkDistance;
        if (dist2 <= md2) {
          const t = 1 - Math.sqrt(dist2) / cfg.maxLinkDistance;
          ctx.strokeStyle = `rgba(160,180,255,${0.08 + 0.22 * t})`;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }
    }
    if (pointer.x > -9990) {
      for (const n of nodes) {
        const dx = n.x - pointer.x,
          dy = n.y - pointer.y,
          dist2 = dx * dx + dy * dy;
        if (dist2 < (cfg.maxLinkDistance * 0.8) ** 2) {
          const dist = Math.sqrt(dist2) || 1;
          ctx.strokeStyle = `rgba(200,220,255,${0.08 + 0.25 * (1 - dist / (cfg.maxLinkDistance * 0.8))})`;
          ctx.beginPath();
          ctx.moveTo(n.x, n.y);
          ctx.lineTo(pointer.x, pointer.y);
          ctx.stroke();
          n.vx += (dx / dist) * 0.02;
          n.vy += (dy / dist) * 0.02;
        }
      }
    }
    ctx.fillStyle = cfg.nodeColor;
    for (const n of nodes) {
      ctx.beginPath();
      ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
      ctx.fill();
    }
    requestAnimationFrame(step);
  }
  let started = false;
  function start() {
    if (!started) {
      initNodes(canvas.clientWidth, canvas.clientHeight);
      started = true;
    }
    requestAnimationFrame(step);
  }
  start();
</script>
