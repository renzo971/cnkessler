---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Typography from "./Typography.astro";

interface Props {
  text: string;
  BackImage: ImageMetadata;
  className?: string;
  sizew?: number;
}
const { BackImage, text, className = "" } = Astro.props;
---

<div class="flex flex-col items-center group w-auto h-auto">
  <!-- Imagen usando la etiqueta <Image> de Astro -->
  <div class="relative w-full">
    <Image
      src={BackImage}
      alt={text}
      class={className + " object-cover w-full h-full"}
      loading="lazy"
    />

    <!-- Texto oculto que aparece al hacer hover (pantallas con hover) -->
    <div
      class="rounded-xl absolute inset-0 flex items-center justify-center bg-black/40 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10 pointer-events-none"
    >
      <p class="text-lg font-bold">{text}</p>
    </div>
  </div>

  <!-- Texto visible solo en dispositivos pequeños (debajo de la imagen) -->
  <Typography
    as="p"
    variant="small"
    color="gris"
    class="mt-2 text-center block z-20 lg:hidden"
  >
    {text}
  </Typography>
</div>
<style>
  img[loading] {
    /* Estilos para la imagen mientras carga */
    background-color: #f0f0f0; /* Color de fondo placeholder */
  }
</style>
