---
const googleMapEmbedUrl =
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d124834.2210317432!2d-77.1201859609375!3d-12.107400999999987!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105c840bd6fb965%3A0x9fdbb6a75370afe0!2sCentro%20Neurodiagn%C3%B3sitco%20Kessler!5e0!3m2!1ses-419!2spe!4v1743786074734!5m2!1ses-419!2spe";
---

<footer
  id="contac"
  class="footer-kessler relative text-white font-montserrat text-bold overflow-hidden pt-6"
>
  <div class="footer-bg"></div>
  <div
    class="footer-content-container relative z-2 max-w-32 m-auto flex justify-between"
    style="   position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;"
  >
    <div class="contact-info">
      <h2>CONTÁCTANOS</h2>
      <ul>
        <li>
          <a
            href="https://www.cnkessler.com"
            target="_blank"
            aria-label="Website"
          >
            <i class="fas fa-globe"></i> www.cnkessler.com
          </a>
        </li>
        <li>
          <a
            href="https://maps.app.goo.gl/YOUR_GOOGLE_MAPS_LINK"
            target="_blank"
            aria-label="Address"
          >
            <i class="fas fa-map-marker-alt"></i> Av. Pardo y Aliaga 581, San Isidro
            - Interior 101
          </a>
        </li>
        <li>
          <a href="tel:+5116204799"
            ><i class="fas fa-phone"></i> (01) 620 4799 /</a
          >
          <a href="tel:+51992713999"> 992 713 999</a>
        </li>
        <li class="social-links">
          <a href="https://www.facebook.com/CentroKessler" target="_blank"
            ><i class="fab fa-facebook-f"></i></a
          >
          <a href="https://www.instagram.com/CentroKessler" target="_blank"
            ><i class="fab fa-instagram"></i></a
          >
          <a href="https://www.tiktok.com/@CentroKessler" target="_blank"
            ><i class="fab fa-tiktok"></i></a
          >
          <span>Centro Kessler</span>
        </li>
      </ul>
    </div>
    <div class="map-container rounded-tl-lg">
      <iframe
        src={googleMapEmbedUrl}
        width="100%"
        height="400"
        class="rounded-tl-lg"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación de Centro Neurodiagnósitco Kessler"></iframe>
    </div>
  </div>
</footer>
<style>
  /* Container for Contact Info and QR code */
  /* Fondo con imagen + overlay morado */
  .footer-bg {
    position: absolute;
    inset: 0;
    background: url("/fachada.jpg") no-repeat center center/cover;
  }
  .footer-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(124, 50, 136, 0.9); /* morado con transparencia */
  }
  .footer-content-container {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  /* Contact Information Section */

  .contact-info h2 {
    font-size: 1.8em;
    font-weight: bold;
    margin-bottom: 15px;
  }
  .contact-info ul {
    list-style: none;
    padding: 0;
  }

  .contact-info li {
    margin-bottom: 10px;
  }

  .contact-info a {
    color: white;
    text-decoration: none;
  }

  .contact-info a:hover {
    color: #ffcc00; /* Subtle hover effect */
  }

  .contact-info i {
    margin-right: 8px;
    min-width: 18px; /* To align the text nicely */
    text-align: center;
  }

  /* Social Media Specific Styling */
  .social-links {
    margin-top: 15px;
  }

  .social-links a {
    font-size: 1.2em; /* Slightly larger icons */
    margin-right: 15px;
  }

  .social-links span {
    font-weight: bold;
  }

  /* Google Map Container */
  .map-container {
    width: 100%;
    /* The map appears below the contact info, spanning full width */
  }

  .map-container iframe {
    display: block;
  }

  /* --- RESPONSIVENESS (For smaller screens) --- */
  @media (max-width: 768px) {
    .footer-content-container {
      flex-direction: column; /* Stack contact info and QR code vertically */
      align-items: center;
      text-align: center;
      padding-bottom: 0;
    }

    .contact-info {
      margin-bottom: 20px;
    }

    .contact-info li {
      justify-content: center;
    }

    .contact-info h2 {
      text-align: center;
    }

    .social-links {
      /* Center the social links on mobile */
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 20px;
    }

    .social-links span {
      display: none; /* Hide the 'Centro Kessler' text on mobile to save space */
    }

    .qr-code {
      margin-bottom: 30px;
    }
  }
</style>
