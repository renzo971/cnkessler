---
import { Image } from "astro:assets";
import Logo from "../assets/letrasck.png";
import FadeContent from "./magicui/FadeContent";
import Carucel from "./Carrucel.astro";
---

<div class="hero">
  <section id="hero">
    <Image
      class="slidelogo animate-fade-in animate-duration-slowanimate-duration-slow"
      src={Logo}
      alt="Astro Logo"
      width={500}
      fetchpriority="high"
    />
    <Carucel />
  </section>
</div>
<style>
  .hero {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #hero {
    display: flex;
    flex-direction: column;
    align-items: center; /* centrado horizontal */
    justify-content: center; /* centrado vertical */
    padding: 16px, 0px, 16px, 16px;
    text-align: center;
  }
</style>
