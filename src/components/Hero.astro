---
import { Image } from "astro:assets";
import Carucel from "./Carrucel.astro";
import Logowhite from "@/assets/banners/Logowhite.astro";
import portada from "@/assets/banners/portada.png";
---

<div>
  <section
    id="hero"
    class="lg:h-[50vh] md:h-[20vh] h-[20vh] relative overflow-hidden"
  >
    <!-- imagen de fondo ocupando todo el contenedor -->
    <Image
      class="bg-image absolute top-0 left-0 w-full h-full object-cover z-[-1]"
      src={portada}
      alt="portada"
      fetchpriority="high"
    />
    <div class="hero-content">
      <div class="logo-wrapper">
        <Logowhite class="slidelogo animate-fade-in animate-duration-slow" />
      </div>
    </div>
  </section>
  <Carucel />
</div>
<style>
  /* overlay para dar contraste al logo */
  #hero::before {
    display: flex;
    flex-direction: column;
    align-items: center; /* centrado horizontal */
    justify-content: center; /* centrado vertical */
    padding: 16px, 0px, 16px, 16px;
    text-align: center;
  }
  /* contenido encima del fondo */
  .hero-content {
    /* Posiciona el contenido absolutamente sobre el contenedor #hero */
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }
  /* hacer que el logo ocupe el ancho de la pantalla (responsivo) */
  .logo-wrapper {
    width: 80%; /* Más ancho en móviles */
    padding: 0 8px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  /* forzar que el elemento interno (img/svg) escale al contenedor */
  .logo-wrapper > * {
    width: 100%;
    height: auto;
    max-height: 40vh; /* evita que el logo sea excesivamente alto; ajustar según diseño */
    display: block;
  }
  /* ajustes para pantallas más grandes */
  @media (min-width: 768px) {
    .logo-wrapper {
      width: 50%; /* Volvemos al 50% en pantallas de tablet y escritorio */
    }
  }
</style>
