---
import { Image } from "astro:assets";
import equipo from "../assets/equipo/equipo.webp";
import Titles from "./Titles.astro";
import Typography from "./Typography.astro";
import Corazon from "@/assets/icons/Corazon.astro";
import Ojos from "@/assets/icons/Ojos.astro";
import Nave from "@/assets/icons/Nave.astro";
---

<section class="bg-white py-16">
  <div class="container mx-auto px-5">
    <Titles
      text1="NUESTRA"
      text2="RAZÓN DE SER"
      color="gris"
      inline={true}
      align="center"
    />
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 mt-8">
      <div class="space-y-6">
        <div class="flex items-start gap-4">
          <Corazon height={80} width={80} class="flex-shrink-0" />
          <div>
            <Typography
              as="h3"
              variant="h3"
              color="gris"
              class="font-bold mb-2"
              fontStyle="extrabold"
            >
              PROPÓSITO:
            </Typography>
            <Typography
              as="p"
              variant="small"
              color="gris"
              class="text-justify"
              fontStyle="extrabold"
            >
              Contribuir al bienestar neurológico de nuestros pacientes,
              ofreciendo diagnósticos precisos y confiables realizados con
              tecnología de vanguardia y un equipo humano altamente capacitado,
              que combina la excelencia científica con un trato cercano ético y
              empático, orientado al cuidado de la salud neurológica.
            </Typography>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <Nave height={80} width={80} class="flex-shrink-0" />
          <div>
            <Typography
              as="h3"
              variant="h3"
              color="gris"
              class="mb-2"
              fontStyle="extrabold"
            >
              MISIÓN:
            </Typography>
            <Typography
              as="p"
              variant="small"
              color="gris"
              class="text-justify"
              fontStyle="extrabold"
            >
              Brindar una atención de calidad con excelencia, calidez y
              precisión en el diagnóstico de las afecciones neurológicas.
            </Typography>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <Ojos height={80} width={80} class="flex-shrink-0" />
          <div>
            <Typography
              as="h3"
              variant="h3"
              color="gris"
              class="mb-2"
              fontStyle="black"
            >
              VISIÓN:
            </Typography>
            <Typography
              as="p"
              variant="small"
              color="gris"
              class="text-justify"
              fontStyle="extrabold"
            >
              Ser un centro líder en el cuidado de la salud neurológica a nivel
              Latinoamérica, con un compromiso de innovación y mejora continua,
              brindando una atención de excelencia, con el bienestar de nuestros
              pacientes como nuestra principal motivación.
            </Typography>
          </div>
        </div>
      </div>

      <div class="flex justify-center items-center">
        <Image
          src={equipo}
          alt="Equipo de trabajo"
          class="reveal-scale rounded-3xl shadow-lg w-full max-w-md object-cover"
        />
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes slide-fwd-center {
    0% {
      transform: translateZ(0) scale(0.9);
      opacity: 0;
    }
    100% {
      transform: translateZ(160px) scale(1);
      opacity: 1;
    }
  }

  @keyframes slide-back-center {
    0% {
      transform: translateZ(160px) scale(1);
      opacity: 1;
    }
    100% {
      transform: translateZ(0) scale(0.9);
      opacity: 0;
    }
  }

  .animate-slide-fwd {
    animation: slide-fwd-center 1s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }

  .animate-slide-back {
    animation: slide-back-center 1s cubic-bezier(0.25, 0.46, 0.45, 0.94)
      forwards;
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("animate-slide-fwd");
          entry.target.classList.remove("animate-slide-back");
        } else {
          entry.target.classList.add("animate-slide-back");
          entry.target.classList.remove("animate-slide-fwd");
        }
      });
    },
    { threshold: 0.3 }
  );

  document.querySelectorAll(".reveal-scale").forEach((el) => {
    observer.observe(el);
  });
</script>
