---
import ambientes from "@/assets/banners/ambientes.png";
import equipos from "@/assets/banners/equipos.png";
import estudios from "@/assets/banners/estudios.png";
import pediatricos from "@/assets/banners/pediatricos.png";
import { Image } from "astro:assets";
// Puedes agregar las imágenes que desees usar
const images = [ambientes, equipos, estudios, pediatricos];
const agregatedvalues = [
  {
    texto: "Ambientes acondicionados",
    imagen: ambientes,
    position: "right",
    //icon: computer,
  },
  {
    texto: "Equipos de ultima generación",
    imagen: equipos,
    position: "left",
    // icon: computer,
  },
  {
    texto: "Estudios las 24 horas del día",
    imagen: estudios,
    position: "center",
    //icon: "@/assets/icons/clock.webp",
  },
  {
    texto: "Estudios pedriátricos (niños recién nacidos)",
    imagen: pediatricos,
    position: "center",
    //icon: bear,
  },
];
---

<div class="carousel-container">
  <div class="carousel">
    {
      images.map((img, index) => (
        <div class="carousel-slide" data-index={index}>
          <Image src={img} alt={`Slide ${index + 1}`} />
        </div>
      ))
    }
  </div>
  <button class="carousel-button prev" aria-label="Anterior">&#10094;</button>
  <button class="carousel-button next" aria-label="Siguiente">&#10095;</button>
</div>

<style>
  .carousel-container {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    overflow: hidden;
  }

  .carousel {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }

  .carousel-slide {
    min-width: 100%;
    position: relative;
  }

  .carousel-slide img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .carousel-button {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.5);
    color: white;
    padding: 1rem;
    border: none;
    cursor: pointer;
    border-radius: 50%;
  }

  .prev {
    left: 1rem;
  }

  .next {
    right: 1rem;
  }
</style>
<script>
  function setupCarousel() {
    const carousel = document.querySelector(".carousel") as HTMLElement;
    const slides = document.querySelectorAll(".carousel-slide");
    const prevButton = document.querySelector(".prev");
    const nextButton = document.querySelector(".next");

    if (!carousel || !prevButton || !nextButton) {
      console.error("No se encontraron los elementos necesarios del carrusel");
      return;
    }

    let currentSlide = 0;

    function updateCarousel() {
      carousel.style.transform = `translateX(-${currentSlide * 100}%)`;
    }

    prevButton.addEventListener("click", () => {
      currentSlide = (currentSlide - 1 + slides.length) % slides.length;
      updateCarousel();
    });

    nextButton.addEventListener("click", () => {
      currentSlide = (currentSlide + 1) % slides.length;
      updateCarousel();
    });

    // Auto avance cada 5 segundos
    setInterval(() => {
      currentSlide = (currentSlide + 1) % slides.length;
      updateCarousel();
    }, 3000);
  }

  // Ejecutar cuando el DOM esté listo
  document.addEventListener("DOMContentLoaded", setupCarousel);
</script>
