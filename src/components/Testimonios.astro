---
import Typography from "./Typography.astro";

const opiniones = [
  {
    texto:
      "Neurodiagnostico Kessler es sinónimo de confianza, amabilidad, seguridad y profesionalismo. Es saber que estamos en buenas manos con un diagnóstico certero.",
    autor: "Mamá de Fabianna",
    rating: 5,
    avatar: "/avatars/avatar-purple.svg", // Agregar ruta al avatar
  },
  {
    texto:
      "Para mí Kessler es un centro especializado en exámenes neurológicos pero también en la parte humana; son profesionales empáticos y nos acompañan en el proceso.",
    autor: "Mamá de Joaquín",
    rating: 5,
    avatar: "/avatars/avatar-purple.svg",
  },
  {
    texto:
      "Es el lugar donde nos ayudaron en las pruebas más difíciles para nuestro pequeño, desde sus 2 meses hasta casi 3 años. Agradecemos su apoyo y paciencia.",
    autor: "Mamá de Santiago",
    rating: 5,
    avatar: "/avatars/avatar-purple.svg",
  },
  {
    texto:
      "Llevo a mi hija con total confianza para que le realicen sus exámenes. Recibo cordialidad y profesionalismo.",
    autor: "Mamá de Micaela",
    rating: 4,
    avatar: "/avatars/avatar-purple.svg",
  },
];
---

<section class="py-16 bg-gray-100">
  <div class="max-w-6xl mx-auto px-4 text-center mb-12">
    <Typography as="h2" variant="bigger" color="secondary">OPINIONES</Typography
    >
  </div>

  <div
    class="max-w-6xl mx-auto px-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"
  >
    {
      opiniones.map((o) => (
        <article class="bg-white rounded-2xl overflow-hidden shadow-lg">
          {/* Avatar */}
          <div class="bg-purple-100 pt-8 pb-4 px-4 relative">
            <div class="w-20 h-20 mx-auto rounded-full bg-purple-700 overflow-hidden mb-4">
              <img src={o.avatar} alt="" class="w-full h-full object-cover" />
            </div>
          </div>

          {/* Contenido */}
          <div class="px-6 py-6 bg-purple-100">
            <Typography
              as="p"
              variant="small"
              color="gris"
              class="text-sm leading-relaxed text-center mb-4"
            >
              {o.texto}
            </Typography>

            {/* Estrellas y autor */}
            <div class="flex flex-col items-center gap-3">
              <div class="flex items-center gap-1">
                {Array.from({ length: 5 }).map((_, i) => (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill={i < o.rating ? "#FFD24D" : "#d1c2d8"}
                    class="w-4 h-4"
                    aria-hidden="true"
                  >
                    <path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.789 1.402 8.173L12 18.896l-7.336 3.876 1.402-8.173L.132 9.21l8.2-1.192z" />
                  </svg>
                ))}
              </div>
              <div class="text-sm font-semibold text-purple-800">{o.autor}</div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
