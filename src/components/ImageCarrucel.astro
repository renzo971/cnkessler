---
import { Image } from "astro:assets";
import Typography from "./Typography.astro";

interface Props {
  Arte: ImageMetadata;
  title?: string;
  icon?: any; // Cambiado a any para aceptar componentes SVG
  titlePosition?: "left" | "center" | "right";
}

const {
  Arte,
  title = "Especialistas en tomas",
  icon: Icon, // Renombrado con mayúscula para indicar que es un componente
  titlePosition = "left",
} = Astro.props;

// Mapeo de posiciones a clases de Tailwind
const positionClasses = {
  left: "justify-start pl-8",
  center: "justify-center",
  right: "justify-end pr-8",
};
---

<div class="relative w-full h-full">
  <Image
    src={Arte}
    alt="Banner imagen"
    height={1978}
    width={5692}
    class="w-full h-full object-cover"
    loading="lazy"
    decoding="async"
  />
  <div
    class={`absolute inset-0 flex items-center ${positionClasses[titlePosition]}`}
  >
    <div
      class="animate-fade-in animate-delay-500 w-1/3 lg:h-full md:h-3/4 sm:h-3/4 px-4 text-center flex flex-col items-center gap-6"
    >
      {
        Icon && (
          <Icon class="w-12 h-12 sm:w-16 sm:h-16 md:w-20 md:h-20 lg:w-24 lg:h-24 text-white" />
        )
      }
      <Typography
        as="h3"
        variant="h3"
        color="white"
        fontStyle="black"
        class="text-xl sm:text-2xl md:text-3xl lg:text-3xl leading-tight"
      >
        {title}
      </Typography>
    </div>
  </div>
</div>
