---
import Typography from "./Typography.astro";
import {
  Endocrinología,
  Neurocirugía,
  Neurología,
  Neuropediatría,
  Oftalmología,
  Otorrinolaringología,
  Psiquiatría,
  Reumatología,
  Traumatología,
} from "@/components/icons/icons.jsx";

const especialidades = [
  { title: "Neurología", icon: Neurología },
  { title: "Psiquiatría", icon: Psiquiatría },
  { title: "Oftalmología", icon: Oftalmología },
  { title: "Neuropediatría", icon: Neuropediatría },
  { title: "Traumatología", icon: Traumatología },
  { title: "Otorrinolaringología", icon: Otorrinolaringología },
  { title: "Neurocirugía", icon: Neurocirugía },
  { title: "Reumatología", icon: Reumatología },
  { title: "Endocrinología", icon: Endocrinología },
];
---

<section class="py-12 bg-white" id="especialidades">
  <div class="max-w-6xl mx-auto px-4 text-center">
    <Typography as="h2" variant="bigger" color="secondary">
      Aportamos en el <span class="font-extrabold">diagnóstico</span> de otras <span
        class="font-extrabold">especialidades</span
      >
    </Typography>
  </div>

  <div
    class="max-w-6xl mx-auto px-4 mt-10 grid grid-cols-3 sm:grid-cols-2 md:grid-cols-3 gap-y-10 gap-x-12"
  >
    {
      especialidades.map(({ title, icon: Icon }) => (
        <div class="flex flex-col items-center md:flex-row md:items-center md:justify-start gap-4">
          {/* Se aumenta el tamaño del contenedor del icono de w-12/h-12 a w-14/h-14
              y el padding de p-3/p-3.5 a p-4 para agrandar el icono y su fondo.
              También se unifica el gap a gap-4.
          */}
          <div class="flex-shrink-0 rounded-lg bg-gradient-to-tr from-[#6b1f6f] to-[#7b2a85] p-4 w-18 h-18 flex items-center justify-center text-white">
            <Icon />
          </div>

          <div class="text-center md:text-left">
            <Typography
              as="p"
              variant="small"
              color="gris"
              fontStyle="black"
              class="text-lg md:text-xl font-montserrat"
            >
              {title}
            </Typography>
          </div>
        </div>
      ))
    }
  </div>
</section>
