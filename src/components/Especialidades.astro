---
import Typography from "./Typography.astro";
import {
  Endocrinología,
  Neurocirugía,
  Neurología,
  Neuropediatría,
  Oftalmología,
  Otorrinolaringología,
  Psiquiatría,
  Reumatología,
  Traumatología,
} from "@/components/icons/icons.jsx";

const especialidades = [
  { title: "Neurología", icon: Neurología },
  { title: "Psiquiatría", icon: Psiquiatría },
  { title: "Oftalmología", icon: Oftalmología },
  { title: "Neuropediatría", icon: Neuropediatría },
  { title: "Traumatología", icon: Traumatología },
  { title: "Otorrinolaringología", icon: Otorrinolaringología },
  { title: "Neurocirugía", icon: Neurocirugía },
  { title: "Reumatología", icon: Reumatología },
  { title: "Endocrinología", icon: Endocrinología },
];
---

<section class="py-12 bg-white">
  <div class="max-w-6xl mx-auto px-4 text-center">
    <Typography as="h2" variant="bigger" color="secondary">
      Aportamos en el <span class="font-extrabold">diagnóstico</span> de otras <span
        class="font-extrabold">especialidades</span
      >
    </Typography>
  </div>

  <div
    class="max-w-6xl mx-auto px-4 mt-10 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-y-10 gap-x-12"
  >
    {
      especialidades.map(({ title, icon: Icon }) => (
        <div class="flex flex-col items-center md:flex-row md:items-center md:justify-start gap-3 md:gap-4">
          <div class="flex-shrink-0 rounded-lg bg-gradient-to-tr from-[#6b1f6f] to-[#7b2a85] p-3 md:p-3.5 w-12 h-12 md:w-12 md:h-12 flex items-center justify-center text-white">
            <Icon /> {/* 👈 ahora sí renderiza el componente */}
          </div>

          <div class="text-center md:text-left">
            <p class="text-sm sm:text-base md:text-base text-gray-700 leading-tight">
              {title}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>
